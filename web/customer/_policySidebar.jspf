<%@page pageEncoding="UTF-8"%>
<%@taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<c:if test="${empty footerPolicies}">
    <%
        try {
            dal.GeneralPolicyDAO generalDAO = new dal.GeneralPolicyDAO();
            request.setAttribute("footerPolicies", generalDAO.getFooterPolicies());
        } catch (Exception e) {
            e.printStackTrace();
        }
    %>
</c:if>
<c:if test="${empty categories}">
    <%
        try {
            dal.CategoryDAO catDAO = new dal.CategoryDAO();
            request.setAttribute("categories", catDAO.getAllCategories());
        } catch (Exception e) {
            e.printStackTrace();
        }
    %>
</c:if>
<%
    String sidebarURI = request.getRequestURI();
    String sidebarContextPath = request.getContextPath();
    String sidebarPath = sidebarURI.substring(sidebarContextPath.length());
    String currentIdParam = request.getParameter("id");
    int currentPolicyId = -1;
    if (currentIdParam != null) {
        try {
            currentPolicyId = Integer.parseInt(currentIdParam);
        } catch (Exception ignored) {}
    }
    request.setAttribute("sidebarPath", sidebarPath);
    request.setAttribute("currentPolicyId", currentPolicyId);
%>

<!-- Desktop Sidebar Navigation -->
<div class="policy-sidebar">
    <c:forEach var="p" items="${footerPolicies}">
        <c:choose>
            <c:when test="${p.policyType == 'PRIVACY'}">
                <c:set var="itemUrl" value="/policy/privacy"/>
                <c:set var="isActive" value="${sidebarPath == '/policy/privacy'}"/>
                <c:set var="itemIcon" value="fas fa-shield-alt"/>
            </c:when>
            <c:when test="${p.policyType == 'TERMS'}">
                <c:set var="itemUrl" value="/policy/terms"/>
                <c:set var="isActive" value="${sidebarPath == '/policy/terms'}"/>
                <c:set var="itemIcon" value="fas fa-file-contract"/>
            </c:when>
            <c:when test="${p.policyType == 'SHOPPING_GUIDE'}">
                <c:set var="itemUrl" value="/policy/shopping-guide"/>
                <c:set var="isActive" value="${sidebarPath == '/policy/shopping-guide'}"/>
                <c:set var="itemIcon" value="fas fa-shopping-bag"/>
            </c:when>
            <c:when test="${p.policyType == 'ABOUT'}">
                <c:set var="itemUrl" value="/about"/>
                <c:set var="isActive" value="${sidebarPath == '/about'}"/>
                <c:set var="itemIcon" value="fas fa-info-circle"/>
            </c:when>
            <c:when test="${p.policyType == 'WARRANTY'}">
                <c:set var="itemUrl" value="/policy/warranty"/>
                <c:set var="isActive" value="${sidebarPath == '/policy/warranty'}"/>
                <c:set var="itemIcon" value="fas fa-tools"/>
            </c:when>
            <c:otherwise>
                <c:set var="itemUrl" value="/policy?id=${p.policyId}"/>
                <c:set var="isActive" value="${sidebarPath == '/policy' && currentPolicyId == p.policyId}"/>
                <c:set var="itemIcon" value="fas fa-file-alt"/>
            </c:otherwise>
        </c:choose>
        <a href="${pageContext.request.contextPath}${itemUrl}" class="sidebar-item ${isActive ? 'active' : ''}">
            <i class="${itemIcon}"></i> <span>${p.title}</span> <i class="fas fa-chevron-right chevron"></i>
        </a>
    </c:forEach>
</div>

<!-- Mobile Dropdown Accordion Navigation (Pure HTML/CSS) -->
<details class="policy-mobile-menu">
    <summary class="policy-mobile-summary">
        <i class="fas fa-bars"></i> 
        <span>
            <c:set var="activeTitle" value="Chính sách & Hỗ trợ"/>
            <c:forEach var="p" items="${footerPolicies}">
                <c:choose>
                    <c:when test="${p.policyType == 'PRIVACY' && sidebarPath == '/policy/privacy'}"><c:set var="activeTitle" value="${p.title}"/></c:when>
                    <c:when test="${p.policyType == 'TERMS' && sidebarPath == '/policy/terms'}"><c:set var="activeTitle" value="${p.title}"/></c:when>
                    <c:when test="${p.policyType == 'SHOPPING_GUIDE' && sidebarPath == '/policy/shopping-guide'}"><c:set var="activeTitle" value="${p.title}"/></c:when>
                    <c:when test="${p.policyType == 'ABOUT' && sidebarPath == '/about'}"><c:set var="activeTitle" value="${p.title}"/></c:when>
                    <c:when test="${p.policyType == 'WARRANTY' && sidebarPath == '/policy/warranty'}"><c:set var="activeTitle" value="${p.title}"/></c:when>
                    <c:when test="${sidebarPath == '/policy' && currentPolicyId == p.policyId}"><c:set var="activeTitle" value="${p.title}"/></c:when>
                </c:choose>
            </c:forEach>
            ${activeTitle}
        </span>
        <i class="fas fa-chevron-down summary-chevron"></i>
    </summary>
    <div class="policy-sidebar-mobile-content">
        <c:forEach var="p" items="${footerPolicies}">
            <c:choose>
                <c:when test="${p.policyType == 'PRIVACY'}">
                    <c:set var="itemUrl" value="/policy/privacy"/>
                    <c:set var="isActive" value="${sidebarPath == '/policy/privacy'}"/>
                    <c:set var="itemIcon" value="fas fa-shield-alt"/>
                </c:when>
                <c:when test="${p.policyType == 'TERMS'}">
                    <c:set var="itemUrl" value="/policy/terms"/>
                    <c:set var="isActive" value="${sidebarPath == '/policy/terms'}"/>
                    <c:set var="itemIcon" value="fas fa-file-contract"/>
                </c:when>
                <c:when test="${p.policyType == 'SHOPPING_GUIDE'}">
                    <c:set var="itemUrl" value="/policy/shopping-guide"/>
                    <c:set var="isActive" value="${sidebarPath == '/policy/shopping-guide'}"/>
                    <c:set var="itemIcon" value="fas fa-shopping-bag"/>
                </c:when>
                <c:when test="${p.policyType == 'ABOUT'}">
                    <c:set var="itemUrl" value="/about"/>
                    <c:set var="isActive" value="${sidebarPath == '/about'}"/>
                    <c:set var="itemIcon" value="fas fa-info-circle"/>
                </c:when>
                <c:when test="${p.policyType == 'WARRANTY'}">
                    <c:set var="itemUrl" value="/policy/warranty"/>
                    <c:set var="isActive" value="${sidebarPath == '/policy/warranty'}"/>
                    <c:set var="itemIcon" value="fas fa-tools"/>
                </c:when>
                <c:otherwise>
                    <c:set var="itemUrl" value="/policy?id=${p.policyId}"/>
                    <c:set var="isActive" value="${sidebarPath == '/policy' && currentPolicyId == p.policyId}"/>
                    <c:set var="itemIcon" value="fas fa-file-alt"/>
                </c:otherwise>
            </c:choose>
            <a href="${pageContext.request.contextPath}${itemUrl}" class="sidebar-item ${isActive ? 'active' : ''}">
                <i class="${itemIcon}"></i> <span>${p.title}</span>
            </a>
        </c:forEach>
    </div>
</details>
